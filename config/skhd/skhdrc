# skhd: hotkeys for yabai. Linked to ~/.config/skhd by bootstrap.sh.
# brew install koekeishiya/formulae/skhd && skhd --start-service
# Reload after edits: skhd --restart-service
#
# Space switching mirrors shared/aerospace.toml (alt-N / alt-shift-N), so the
# muscle memory is the same whichever window manager is running.
#
# Needs yabai >= 7.1.19: `space --focus` works with SIP ENABLED from that
# release on (yabai synthesizes a high-velocity Dock swipe gesture). Moving a
# window to another space works with SIP enabled from 7.1.25.
# Spaces must already exist: create 1-9 once in Mission Control, because
# `space --create` still needs the scripting addition (SIP partially off).

# Focus space N
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9

# Toggle to the previously focused space
alt - 0 : yabai -m space --focus recent

# Previous / next space with wrap-around. alt-[ and alt-]; alt-arrows are left
# alone because Karabiner maps ctrl-arrows to alt-arrows for word jumps.
alt - 0x21 : yabai -m space --focus prev || yabai -m space --focus last
alt - 0x1E : yabai -m space --focus next || yabai -m space --focus first

# Send the focused window to space N and follow it.
# Two commands on purpose: `window --space N --focus` misbehaves with SIP on
# (asmvik/yabai#2788); the maintainer's workaround is move, then focus.
alt + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2; yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3; yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4; yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5; yabai -m space --focus 5
alt + shift - 6 : yabai -m window --space 6; yabai -m space --focus 6
alt + shift - 7 : yabai -m window --space 7; yabai -m space --focus 7
alt + shift - 8 : yabai -m window --space 8; yabai -m space --focus 8
alt + shift - 9 : yabai -m window --space 9; yabai -m space --focus 9
