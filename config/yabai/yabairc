# Copying the script from: https://www.josean.com/posts/yabai-setup
# yabai --restart-service
# brew install koekeishiya/formulae/yabai
# yabai --start-service

# default layout (can be bsp, stack or float)
yabai -m config layout bsp

# New window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# padding set - ideally depeneds on monitor size
yabai -m config top_padding 4
yabai -m config bottom_padding 4
yabai -m config left_padding 4
yabai -m config right_padding 2
yabai -m config window_gap 4


# center mouse on window with focus
yabai -m config mouse_follows_focus on

# modifier for clicking and dragging with mouse
yabai -m config mouse_modifier alt
# set modifier + left-click drag to move window
yabai -m config mouse_action1 move
# set modifier + right-click drag to resize window
yabai -m config mouse_action2 resize


# when window is dropped in center of another window, swap them (on edges it will split it)
yabai -m config mouse_drop_action swap

yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="Alfred" manage=off
yabai -m rule --add app="QuickRecorder" manage=off
yabai -m rule --add app="^LCD Timer$" manage=off
# rule --add only affects windows created later; apply the rules to the windows yabai tiled at startup too.
yabai -m rule --apply

# --- Ghostty tab workaround ---
# When a Ghostty window (tab) is created, re-apply bsp layout.
yabai -m signal --add app='^Ghostty$' event=window_created   action='yabai -m space --layout bsp'

# When a Ghostty window (tab) is destroyed, re-apply bsp layout.
yabai -m signal --add app='^Ghostty$' event=window_destroyed action='yabai -m space --layout bsp'

# --- Debug logging, for reporting layout bugs upstream (yabai-debug skill in the alfred repo) ---
# yabai's event stream, untimestamped, goes to the launchd stdout file: /tmp/yabai_$USER.out.log.
yabai -m config debug_output on
# trace.sh appends each event with a timestamp and the window frames to ~/.cache/yabai/trace.log.
for event in window_created window_destroyed window_moved window_resized window_minimized window_deminimized \
             application_hidden application_visible space_changed display_added display_removed display_moved \
             display_resized display_changed mission_control_exit system_woke; do
  yabai -m signal --add label="trace_$event" event="$event" action="$HOME/.config/yabai/trace.sh $event"
done
